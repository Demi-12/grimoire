{
  "name": "grimoire-dnd-toolkit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @grimoire/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "node apps/api/dist/main.js",
    "test": "pnpm -r test && vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.15.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.2"
  }
}
