# Copy to .env for local development. Replace every blank value locally.
# Never put real credentials in this file or commit .env files.
POSTGRES_DB=grimoire
POSTGRES_USER=grimoire
POSTGRES_PASSWORD=
DATABASE_URL=
CLOUDFLARE_TUNNEL_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional, comma-separated: other URLs you open the toolkit from (e.g. the LAN address).
BETTER_AUTH_TRUSTED_ORIGINS=
PASSKEY_RP_ID=
# Comma-separated emails that are always approved site admins (your own account). Everyone else who
# signs up waits in the admin panel until an admin approves them. DM/player is decided per campaign.
GRIMOIRE_ADMIN_EMAILS=
# Optional: SMTP for password-reset emails (any provider, e.g. Brevo: smtp-relay.brevo.com:587,
# user = SMTP login, password = SMTP key, SMTP_FROM = a verified sender). Without it, passwords
# cannot be reset by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: separate migration role. Defaults to POSTGRES_USER/POSTGRES_PASSWORD.
# If you set it, grant the app user privileges on the tables it creates.
LIQUIBASE_DB_USERNAME=
LIQUIBASE_DB_PASSWORD=
