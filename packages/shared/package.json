{
  "name": "@grimoire/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure D&D rules, validation and types shared by the API and the web app. No database, no framework.",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
